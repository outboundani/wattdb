      "indexes": {
        "primary": {"pk":{"field":"memberId","composite":["memberId"]}},
        "byTeamNumber": {"index":"teamNumber","pk":{"field":"teamNumber","composite":["teamNumber"]}},
        "byRank": {"index":"gsi1","pk":{"field":"gsi1pk","composite":["rank"],"cast":"number"}},
        "byLevelString": {"index":"gsi2","pk":{"field":"gsi2pk","composite":["level"],"cast":"string"}}
      }
    }
  },
  "cases": [
