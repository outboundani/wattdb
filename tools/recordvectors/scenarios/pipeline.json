{
  "description": "The item pipeline: defaults, validation, setters and watchers on write; field translation; getters, watchers and hidden attributes on read; type checks; maps, lists and sets.",
  "entities": {
    "doc": {
      "model": {"entity": "doc", "version": "1", "service": "taskapp"},
      "attributes": {
        "docId": {"type": "string", "required": true},
        "code": {"type": "string", "set": {"$fn": "upper"}, "validate": {"$fn": "regexp", "args": ["^[A-Z]+$"]}},
        "title": {"type": "string", "field": "t", "get": {"$fn": "prefix", "args": ["got:"]}},
        "count": {"type": "number"},
        "done": {"type": "boolean"},
        "kind": {"type": ["note", "task"], "default": "note"},
        "status": {"type": "string", "required": true, "default": "open"},
        "tags": {"type": "set", "items": "string"},
        "scores": {"type": "set", "items": "number"},
        "meta": {"type": "map", "properties": {
          "source": {"type": "string", "default": "web"},
          "rank": {"type": "number", "field": "r"},
          "inner": {"type": "map", "properties": {"deep": {"type": "string", "field": "d"}}}
        }},
        "opts": {"type": "map", "properties": {"a": {"type": "string"}}},
        "steps": {"type": "list", "items": {"type": "map", "properties": {
          "name": {"type": "string", "required": true, "field": "n"},
          "ok": {"type": "boolean"}
        }}},
        "notes": {"type": "list", "items": {"type": "string", "validate": {"$fn": "minLength", "args": [2]}}},
        "blob": {"type": "any"},
        "summary": {"type": "string", "watch": "*", "set": {"$fn": "join", "args": ["/", "kind", "status"]}, "get": {"$fn": "upper"}},
        "secret": {"type": "string", "hidden": true}
      },
      "indexes": {
        "primary": {"pk": {"field": "pk", "composite": ["docId"]}, "sk": {"field": "sk", "composite": []}}
      }
    }
  },
  "cases": [
    {"name": "put minimal applies defaults and watchAll", "entity": "doc", "chain": [["put", {"docId": "d1"}]], "go": false},
    {"name": "validation runs before setters", "entity": "doc", "chain": [["put", {"docId": "d1", "code": "abc"}]], "go": false},
    {"name": "setter output is not validated", "entity": "doc", "chain": [["put", {"docId": "d1", "code": "ABC"}]], "go": false},
    {"name": "unknown root attributes are dropped", "entity": "doc", "chain": [["put", {"docId": "d1", "nope": 1}]], "go": false},
    {"name": "field renames", "entity": "doc", "chain": [["put", {"docId": "d1", "title": "Hi"}]], "go": false},
    {"name": "wrong scalar types", "entity": "doc", "chain": [["put", {"docId": "d1", "count": "5", "done": "yes", "title": 3}]], "go": false},
    {"name": "null for a string", "entity": "doc", "chain": [["put", {"docId": "d1", "title": null}]], "go": false},
    {"name": "invalid enum", "entity": "doc", "chain": [["put", {"docId": "d1", "kind": "memo"}]], "go": false},
    {"name": "explicit value overrides default", "entity": "doc", "chain": [["put", {"docId": "d1", "kind": "task", "status": "closed"}]], "go": false},
    {"name": "set dedupes", "entity": "doc", "chain": [["put", {"docId": "d1", "tags": ["b", "a", "b"], "scores": [3, 1, 3]}]], "go": false},
    {"name": "empty set", "entity": "doc", "chain": [["put", {"docId": "d1", "tags": []}]], "go": false},
    {"name": "set from a single string", "entity": "doc", "chain": [["put", {"docId": "d1", "tags": "solo"}]], "go": false},
    {"name": "set with a wrong item type", "entity": "doc", "chain": [["put", {"docId": "d1", "tags": ["a", 2]}]], "go": false},
    {"name": "empty optional map", "entity": "doc", "chain": [["put", {"docId": "d1", "opts": {}}]], "go": false},
    {"name": "map applies nested defaults and renames", "entity": "doc", "chain": [["put", {"docId": "d1", "meta": {"rank": 2, "inner": {"deep": "x"}}}]], "go": false},
    {"name": "empty map gets nested defaults", "entity": "doc", "chain": [["put", {"docId": "d1", "meta": {}}]], "go": false},
    {"name": "map drops unknown properties", "entity": "doc", "chain": [["put", {"docId": "d1", "opts": {"a": "1", "zz": "2"}}]], "go": false},
    {"name": "map given a non-object", "entity": "doc", "chain": [["put", {"docId": "d1", "opts": "nope"}]], "go": false},
    {"name": "list of maps with renames", "entity": "doc", "chain": [["put", {"docId": "d1", "steps": [{"name": "a", "ok": true}, {"name": "b"}]}]], "go": false},
    {"name": "list item missing a required property", "entity": "doc", "chain": [["put", {"docId": "d1", "steps": [{"ok": true}]}]], "go": false},
    {"name": "list item failing validate", "entity": "doc", "chain": [["put", {"docId": "d1", "notes": ["ok", "x"]}]], "go": false},
    {"name": "empty list", "entity": "doc", "chain": [["put", {"docId": "d1", "notes": []}]], "go": false},
    {"name": "any keeps nulls and nesting", "entity": "doc", "chain": [["put", {"docId": "d1", "blob": {"a": null, "b": [1, {"c": false}], "d": {}}}]], "go": false},
    {"name": "hidden attribute is written", "entity": "doc", "chain": [["put", {"docId": "d1", "secret": "s"}]], "go": false},
    {"name": "read formatting", "entity": "doc", "params": false,
      "chain": [["get", {"docId": "d1"}]],
      "responses": [{"Item": {
        "pk": {"S": "$taskapp#docid_d1"}, "sk": {"S": "$doc_1"},
        "docId": {"S": "d1"}, "t": {"S": "Hi"}, "kind": {"S": "note"}, "status": {"S": "open"},
        "tags": {"SS": ["a", "b"]}, "scores": {"NS": ["1", "3"]},
        "meta": {"M": {"source": {"S": "web"}, "r": {"N": "2"}, "extra": {"S": "x"}, "inner": {"M": {"d": {"S": "y"}}}}},
        "opts": {"M": {}},
        "steps": {"L": [{"M": {"n": {"S": "a"}, "ok": {"BOOL": true}}}]},
        "blob": {"M": {"a": {"NULL": true}}},
        "summary": {"S": "note/open"}, "secret": {"S": "s"}, "unknownField": {"S": "u"},
        "__edb_e__": {"S": "doc"}, "__edb_v__": {"S": "1"}}}]},
    {"name": "read runs watchAll getters for absent attributes", "entity": "doc", "params": false,
      "chain": [["get", {"docId": "d1"}]],
      "responses": [{"Item": {"pk": {"S": "$taskapp#docid_d1"}, "sk": {"S": "$doc_1"}, "docId": {"S": "d1"}, "status": {"S": "open"}, "__edb_e__": {"S": "doc"}, "__edb_v__": {"S": "1"}}}]},
    {"name": "read with includeKeys", "entity": "doc", "params": false,
      "chain": [["get", {"docId": "d1"}]], "go": {"data": "includeKeys"},
      "responses": [{"Item": {"pk": {"S": "$taskapp#docid_d1"}, "sk": {"S": "$doc_1"}, "docId": {"S": "d1"}, "status": {"S": "open"}, "__edb_e__": {"S": "doc"}, "__edb_v__": {"S": "1"}}}]},
    {"name": "read with attributes", "entity": "doc", "params": false,
      "chain": [["get", {"docId": "d1"}]], "go": {"attributes": ["docId", "title"]},
      "responses": [{"Item": {"docId": {"S": "d1"}, "t": {"S": "Hi"}, "__edb_e__": {"S": "doc"}, "__edb_v__": {"S": "1"}}}]}
  ]
}
