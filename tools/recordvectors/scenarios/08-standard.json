{
  "description": "Tier 8: standard prefixed keys, multiple GSIs, enums with defaults, nested map/list attributes, and a scan over all pages.",
  "entities": {
    "user": {
      "model": {"entity":"user","version":"1","service":"taskapp"},
      "attributes": {
        "orgId": {"type":"string","required":true},
        "userId": {"type":"string","required":true},
        "email": {"type":"string","required":true},
        "role": {"type":["admin","member","guest"],"required":true,"default":"member"},
        "status": {"type":["active","disabled"],"default":"active"},
        "profile": {
          "type": "map",
          "properties": {
            "displayName": {"type":"string"},
            "links": {"type":"list","items":{"type":"string"}},
            "address": {
              "type": "map",
              "properties": {"city":{"type":"string"},"zip":{"type":"string","field":"postalCode"}}
            }
          }
        }
      },
      "indexes": {
        "primary": {"pk":{"field":"pk","composite":["orgId"]},"sk":{"field":"sk","composite":["userId"]}},
        "byEmail": {
          "index": "gsi1",
          "pk": {"field":"gsi1pk","composite":["email"]},
          "sk": {"field":"gsi1sk","composite":[]}
        },
        "byRole": {
          "index": "gsi2",
          "pk": {"field":"gsi2pk","composite":["orgId"]},
          "sk": {"field":"gsi2sk","composite":["role","userId"]}
        }
      }
    }
  },
  "cases": [
    {
      "name": "put applies enum defaults and maps nested fields",
      "entity": "user",
      "chain": [
        [
          "put",
          {
            "orgId": "O-1",
            "userId": "U-1",
            "email": "Ada@Example.com",
            "profile": {"displayName":"Ada","links":["a","b"],"address":{"city":"London","zip":"N1"}}
          }
        ]
      ]
    },
    {
      "name": "query by role with partial sk",
      "entity": "user",
      "chain": [["query.byRole",{"orgId":"O-1","role":"admin"}]]
    },
    {
      "name": "query by email",
      "entity": "user",
      "chain": [["query.byEmail",{"email":"Ada@Example.com"}]]
    },
    {
      "name": "scan all pages",
      "entity": "user",
      "chain": [["scan"]],
      "go": {"pages":"all"},
      "responses": [
        {
          "Items": [
            {
              "pk": {"S":"$taskapp#orgid_o-1"},
              "sk": {"S":"$user_1#userid_u-1"},
              "orgId": {"S":"O-1"},
              "userId": {"S":"U-1"},
              "email": {"S":"a@example.com"},
              "role": {"S":"member"},
              "profile": {"M":{"address":{"M":{"postalCode":{"S":"N1"}}}}},
              "__edb_e__": {"S":"user"},
              "__edb_v__": {"S":"1"}
            }
          ],
          "Count": 1,
          "ScannedCount": 1,
          "LastEvaluatedKey": {"pk":{"S":"$taskapp#orgid_o-1"},"sk":{"S":"$user_1#userid_u-1"}}
        },
        {
          "Items": [
            {
              "pk": {"S":"$taskapp#orgid_o-1"},
              "sk": {"S":"$user_1#userid_u-2"},
              "orgId": {"S":"O-1"},
              "userId": {"S":"U-2"},
              "email": {"S":"b@example.com"},
              "role": {"S":"admin"},
              "__edb_e__": {"S":"user"},
              "__edb_v__": {"S":"1"}
            }
          ],
          "Count": 1,
          "ScannedCount": 1
        }
      ]
    },
    {
      "name": "query one page returns a cursor",
      "entity": "user",
      "chain": [["query.primary",{"orgId":"O-1"}]],
      "params": false,
      "responses": [
        {
          "Items": [],
          "Count": 0,
          "ScannedCount": 0,
          "LastEvaluatedKey": {"pk":{"S":"$taskapp#orgid_o-1"},"sk":{"S":"$user_1#userid_u-1"}}
        }
      ]
    },
    {
      "name": "query with a cursor",
      "entity": "user",
      "chain": [["query.primary",{"orgId":"O-1"}]],
      "go": {"cursor":"eyJwayI6IiR0YXNrYXBwI29yZ2lkX28tMSIsInNrIjoiJHVzZXJfMSN1c2VyaWRfdS0xIn0"},
      "params": {"cursor":"eyJwayI6IiR0YXNrYXBwI29yZ2lkX28tMSIsInNrIjoiJHVzZXJfMSN1c2VyaWRfdS0xIn0"}
    }
  ]
}
