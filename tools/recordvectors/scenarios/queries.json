{
  "description": "Queries and scans: every sort-key operation, compare modes, filters, options, pagination (pages, count), cursors, ownership, clustered/keys_only/include indexes, hydrate, raw/includeKeys data, and table and index scans.",
  "entities": {
    "task": {
      "model": {"entity":"task","version":"1","service":"taskapp"},
      "attributes": {
        "projectId": {"type":"string","required":true},
        "taskId": {"type":"string","required":true},
        "title": {"type":"string"},
        "status": {"type":["open","done"],"required":true},
        "priority": {"type":"number","padding":{"length":5,"char":"0"}},
        "createdAt": {"type":"string"},
        "assignee": {"type":"string"},
        "secret": {"type":"string","hidden":true}
      },
      "indexes": {
        "primary": {
          "pk": {"field":"pk","composite":["projectId"],"facets":["projectId"]},
          "sk": {"field":"sk","composite":["taskId"],"facets":["taskId"]}
        },
        "byStatus": {
          "index": "gsi1",
          "pk": {"field":"gsi1pk","composite":["projectId"],"facets":["projectId"]},
          "sk": {
            "field": "gsi1sk",
            "composite": ["status","priority","createdAt"],
            "facets": ["status","priority","createdAt"]
          }
        },
        "byAssignee": {
          "index": "gsi2",
          "projection": "keys_only",
          "pk": {"field":"gsi2pk","composite":["assignee"],"facets":["assignee"]},
          "sk": {"field":"gsi2sk","composite":["taskId"],"facets":["taskId"]}
        },
        "byStatusCluster": {
          "index": "gsi3",
          "type": "clustered",
          "pk": {"field":"gsi3pk","composite":["status"],"facets":["status"]},
          "sk": {"field":"gsi3sk","composite":["projectId","taskId"],"facets":["projectId","taskId"]}
        },
        "byTitle": {
          "index": "gsi4",
          "projection": ["title"],
          "pk": {"field":"gsi4pk","composite":["projectId"],"facets":["projectId"]},
          "sk": {"field":"gsi4sk","composite":["title"],"facets":["title"]}
        }
      }
    }
  },
